# ==============================================================================
# VIRTUAL Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug

# Database (PostgreSQL)
DATABASE_URL="postgresql://virtual_user:virtual_secure_password@localhost:5432/virtual_db?schema=public"

# Authentication & JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_virtual_production_2026_xyz
REFRESH_TOKEN_SECRET=super_secret_jwt_refresh_key_virtual_production_2026_abc
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=30d

# WebRTC STUN & TURN Configuration
# Public STUN server (used for NAT IP discovery)
STUN_SERVER_URL=stun:stun.l.google.com:19302

# Dedicated Coturn TURN Server (used when direct P2P fails on symmetric NAT/4G/5G)
TURN_SERVER_URL=turn:turn.virtualcam.io:3478
TURN_USERNAME=virtual_turn_user
TURN_PASSWORD=virtual_turn_secret_auth_token_99

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=virtual-camera-system
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@virtual-camera-system.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# CORS Allowed Origins
CORS_ORIGIN=*
